  .ditem__points li::before {
    content: "";
    position: absolute;
    left: 0;
    top: 0.55em;
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 2px;
    background: var(--leaf);
    transform: rotate(45deg);
  }
  .ditem__url {
    margin: 1.1rem 0 0;
    font-family: var(--font-mono);
    font-size: 0.78rem;
    color: var(--muted);
  }
  .ditem__pending {
    opacity: 0.8;
  }

  .picker__marquee {
    /* --fade is set by JS, sized to how much the row overflows (i.e. the
       number of companies/projects vs. the available width). 0 = no fade. */
    --fade: 0px;
    overflow: hidden;
    border-top: 1px solid var(--line);
    padding-top: 1.1rem;
    -webkit-mask-image: linear-gradient(90deg, transparent 0, #000 var(--fade), #000 calc(100% - var(--fade)), transparent 100%);
    mask-image: linear-gradient(90deg, transparent 0, #000 var(--fade), #000 calc(100% - var(--fade)), transparent 100%);
  }
  .picker__track {
    display: flex;
    gap: 0.7rem;
    width: max-content;
    margin: 0;
    padding: 0.2rem;
    list-style: none;
  }
  /* Few enough items to fit: show each once, centered, no scroll, no fade. */
  .picker__marquee.is-static .picker__track {
    width: 100%;
    flex-wrap: wrap;
    justify-content: center;
    row-gap: 0.7rem;
  }
  /* Too many to fit: seamless single-occurrence loop (JS clones one set). */
  .picker__marquee.is-scroll .picker__track {
    animation: scroll 34s linear infinite;
  }
  .picker__marquee.is-scroll:hover .picker__track {
    animation-play-state: paused;
  }
  /* Reduced-motion overflow: native horizontal scroll, single set. */
  .picker__marquee.is-scrollable {
    overflow-x: auto;
  }
  .pickitem {
    flex: none;
    width: 6.5rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.45rem;
    padding: 0.8rem 0.5rem;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    cursor: pointer;
    appearance: none;
    transition: border-color var(--dur-fast) var(--ease-out-quint), transform var(--dur-fast) var(--ease-out-quint), background var(--dur-fast) var(--ease-out-quint);
  }
  .pickitem:hover,
  .pickitem:focus-visible {
    border-color: var(--coral);
    background: var(--surface-2);
    transform: translateY(-3px);
  }
  .pickitem__img {
    width: 2.6rem;
    height: 2.6rem;
    object-fit: contain;
  }
  .pickitem__img--proj {
    display: grid;
    place-items: center;
  }
  .pickitem__svg {
    width: 2.2rem;
    height: 2.2rem;
    display: grid;
    place-items: center;
  }
  .pickitem__svg :global(svg) {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }
  .pickitem__mono {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 1.2rem;
    color: var(--coral-ink);
  }
  .pickitem__name {
    font-family: var(--font-mono);
    font-size: 0.66rem;
    color: var(--muted);
    text-align: center;
    line-height: 1.2;
