---
import { meta } from "../data/content";
---

<header class="nav" id="nav" data-nav>
  <div class="shell nav__inner">
    <a href="#top" class="nav__mark" aria-label={`${meta.name} — home`}>
      <span class="nav__bug" aria-hidden="true"></span>
      <span class="nav__name">{meta.name}</span>
    </a>

    <nav class="nav__links" aria-label="Sections">
      <a href="#work">Work</a>
      <a href="#projects">Projects</a>
      <a href="#contact">Contact</a>
    </nav>

    <button type="button" class="nav__play" data-game-endless hidden>
      <span class="nav__play-dot" aria-hidden="true"></span>
      Squash bugs
    </button>
  </div>
</header>

<style>
  .nav {
    position: sticky;
    top: 0;
    z-index: var(--z-sticky);
    transition:
      background var(--dur) var(--ease-out-quint),
      box-shadow var(--dur) var(--ease-out-quint),
      border-color var(--dur) var(--ease-out-quint);
    border-bottom: 1px solid transparent;
  }
  .nav[data-stuck="true"] {
    background: color-mix(in oklch, var(--bg) 80%, transparent);
    backdrop-filter: saturate(1.4) blur(12px);
    border-bottom-color: var(--line);
  }
  .nav__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    height: 4.25rem;
  }
  .nav__mark {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.05rem;
    letter-spacing: -0.02em;
  }
  .nav__bug {
    width: 0.85rem;
    height: 0.85rem;
    border-radius: 999px 999px 60% 60%;
    background: var(--coral);
    box-shadow:
      0 0 0 2px var(--bg),
      inset 0 -2px 0 oklch(0.45 0.18 30 / 0.5);
    position: relative;
    flex: none;
  }
  .nav__bug::before {
    /* head */
    content: "";
    position: absolute;
    top: -0.28rem;
    left: 50%;
    transform: translateX(-50%);
    width: 0.42rem;
    height: 0.42rem;
    border-radius: 999px;
    background: var(--ink);
  }
  .nav__links {
    display: none;
    gap: 1.75rem;
    font-weight: 500;
    font-size: 0.98rem;
    margin-inline-start: auto;
    margin-inline-end: 1.5rem;
  }
  .nav__links a {
    color: var(--muted);
    position: relative;
    padding-block: 0.3rem;
    transition: color var(--dur-fast) var(--ease-out-quint);
  }
  .nav__links a::after {
    content: "";
    position: absolute;
    left: 0;
    bottom: 0;
    width: 100%;
    height: 2px;
    background: var(--coral);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform var(--dur) var(--ease-out-expo);
  }
  .nav__links a:hover {
    color: var(--ink);
  }
  .nav__links a:hover::after {
    transform: scaleX(1);
  }
  .nav__play {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-mono);
    font-size: 0.82rem;
    font-weight: 500;
    padding: 0.5rem 0.95rem;
    border-radius: var(--radius-pill);
    border: 1.5px solid var(--line-strong);
    color: var(--ink);
    background: var(--bg);
    cursor: pointer;
    transition:
      border-color var(--dur-fast) var(--ease-out-quint),
      transform var(--dur-fast) var(--ease-out-quint);
  }
  .nav__play:hover {
    border-color: var(--coral-ink);
    transform: translateY(-1px);
  }
  .nav__play-dot {
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 999px;
    background: var(--coral);
    animation: pulse 2.4s var(--ease-out-quint) infinite;
  }
  @keyframes pulse {
    0%,
    100% {
      opacity: 1;
      transform: scale(1);
    }
    50% {
      opacity: 0.4;
      transform: scale(0.7);
    }
  }

  /* The bug game is a desktop-first delight; keep the mobile bar clean. */
  @media (max-width: 559px) {
    .nav__play {
      display: none;
    }
  }
  @media (min-width: 768px) {
    .nav__links {
      display: flex;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .nav__play-dot {
      animation: none;
    }
  }
</style>

<script>
  // Toggle a "stuck" state once the hero starts scrolling under the bar.
  const nav = document.querySelector<HTMLElement>("[data-nav]");
  if (nav) {
    const onScroll = () => {
      nav.dataset.stuck = window.scrollY > 24 ? "true" : "false";
    };
    onScroll();
    window.addEventListener("scroll", onScroll, { passive: true });
  }
</script>
