---
// The bug game. On the enhanced path it starts on page load and IS the entry:
// squash bugs (eight silhouettes across Sev 0-4 — flyers flap, crawlers walk,
// a centipede snakes) before they drain System health. The red KILL SWITCH still
// ends it early; letting health hit red loses but still reveals the site.
// Re-openable from the hub ("Squash bugs").
// Pure enhancement — fired by `game:open`, never shown when motion is reduced.
---

<div
  class="game"
  id="game"
  data-game
  hidden
  aria-hidden="true"
  role="dialog"
  aria-label="Squash the bugs — a little game"
>
  <canvas class="game__canvas" data-game-canvas></canvas>

  <p class="game__prompt" data-game-prompt></p>
  <p class="game__hint" data-game-hint></p>

  <div class="game__score" data-game-score>
    <span class="game__score-bug" aria-hidden="true"></span>
    <span>Score</span>
    <strong data-game-score-value>0</strong>
  </div>

  <div class="game__health" data-health>
    <span class="game__health-label">System health</span>
    <span class="game__health-track"><span class="game__health-fill" data-health-fill></span></span>
  </div>

  <div class="game__killwrap" data-killwrap>
    <span class="game__killtip" data-killtip aria-hidden="true">KILL SWITCH</span>
    <button
      type="button"
      class="game__kill"
      data-game-kill
      data-game-control
      aria-label="Kill switch — stop the game and see the page"
    >
      <svg viewBox="0 0 24 24" width="22" height="22" fill="none" aria-hidden="true">
        <path
          d="M12 3v9"
          stroke="currentColor"
          stroke-width="2.4"
          stroke-linecap="round"></path>
        <path
          d="M6.6 7a8 8 0 1 0 10.8 0"
          stroke="currentColor"
          stroke-width="2.4"
          stroke-linecap="round"></path>
      </svg>
    </button>
  </div>

  <div class="game__over" data-lose data-game-control>
    <div class="game__over-card">
      <p class="game__over-eyebrow">Sev 0 · Production incident</p>
      <h2 class="game__over-title">Oh no! The system crashed</h2>
      <p class="game__over-sub">The bugs you ignored took production down.</p>
      <div class="game__over-scores">
        <div class="game__over-stat">
          <span>Score</span>
          <strong data-lose-score>0</strong>
        </div>
        <div class="game__over-stat">
          <span>Best</span>
          <strong data-lose-best>0</strong>
        </div>
      </div>
      <p class="game__over-record" data-lose-record hidden>★ New best!</p>
      <div class="game__over-actions">
        <button type="button" class="game__over-btn game__over-btn--primary" data-game-control data-lose-replay>
          Replay
        </button>
        <button type="button" class="game__over-btn" data-game-control data-lose-home>Go home</button>
      </div>
    </div>
  </div>

  <div class="game__swatter" data-game-swatter aria-hidden="true">
    <svg viewBox="0 0 80 96" width="80" height="96" fill="none">
      <line x1="40" y1="52" x2="40" y2="92" stroke="oklch(0.74 0.04 60)" stroke-width="7" stroke-linecap="round"></line>
      <rect x="10" y="6" width="60" height="50" rx="16" fill="oklch(0.7 0.19 34)" stroke="oklch(0.5 0.16 30)" stroke-width="3"></rect>
      <g stroke="oklch(0.45 0.16 30)" stroke-width="2.4" opacity="0.8">
        <line x1="24" y1="14" x2="24" y2="48"></line>
        <line x1="40" y1="10" x2="40" y2="50"></line>
        <line x1="56" y1="14" x2="56" y2="48"></line>
        <line x1="14" y1="22" x2="66" y2="22"></line>
        <line x1="12" y1="34" x2="68" y2="34"></line>
        <line x1="14" y1="46" x2="66" y2="46"></line>
      </g>
    </svg>
  </div>

  <button
    type="button"
    class="game__mute"
    data-game-mute
    data-game-control
    aria-pressed="false"
    aria-label="Mute sound"
  >
    <svg viewBox="0 0 24 24" width="20" height="20" fill="none" aria-hidden="true">
      <path
        class="game__mute-speaker"
        d="M4 9.5v5h3.5L12 18V6L7.5 9.5H4z"
        fill="currentColor"
        stroke="currentColor"
        stroke-width="1.6"
        stroke-linejoin="round"></path>
      <g class="game__mute-waves" stroke="currentColor" stroke-width="1.8" stroke-linecap="round">
        <path d="M15.5 9a4.5 4.5 0 0 1 0 6"></path>
        <path d="M18 6.5a8 8 0 0 1 0 11"></path>
      </g>
      <line
        class="game__mute-slash"
        x1="3.5"
        y1="3.5"
        x2="20.5"
        y2="20.5"
        stroke="currentColor"
        stroke-width="1.8"
        stroke-linecap="round"></line>
    </svg>
  </button>
</div>

<style>
  .game {
    position: fixed;
    inset: 0;
    z-index: var(--z-overlay);
    background:
      radial-gradient(120% 90% at 50% 12%, color-mix(in oklch, var(--surface) 70%, var(--bg)), var(--bg) 70%),
      var(--bg);
    opacity: 0;
    transition:
      opacity 0.4s var(--ease-out-quint),
      background 0.7s var(--ease-out-quint);
    cursor: none;
    user-select: none;
    touch-action: none;
  }
  .game[data-open="true"] {
    opacity: 1;
  }
  .game[data-touch="true"] {
    cursor: auto;
  }
  /* On kill-switch: drop the backdrop + let clicks through, so the page loads
     in beneath while the bugs walk out over it. */
  .game[data-scatter="true"] {
    background: transparent;
    pointer-events: none;
    cursor: auto;
  }

  .game__canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .game__prompt {
    position: absolute;
    left: 50%;
    top: 50%;
    transform: translate(-50%, -50%) scale(0.97);
    margin: 0;
    width: min(90vw, 22ch);
    text-align: center;
    font-family: var(--font-display);
    font-weight: 800;
    font-size: clamp(2.1rem, 1.3rem + 3.8vw, 4rem);
    letter-spacing: -0.03em;
    color: var(--ink);
    text-shadow:
      0 2px 16px oklch(0.12 0.01 50 / 0.9),
      0 0 3px oklch(0.12 0.01 50 / 0.7);
    text-wrap: balance;
    opacity: 0;
    transition:
      opacity 0.45s var(--ease-out-expo),
      transform 0.45s var(--ease-out-expo);
  }
  .game__prompt[data-show="true"] {
    opacity: 1;
    transform: translate(-50%, -50%) scale(1);
  }

  .game__hint {
    position: absolute;
    left: 50%;
    bottom: clamp(1.5rem, 5vh, 3rem);
    transform: translateX(-50%);
    margin: 0;
    text-align: center;
    font-family: var(--font-mono);
    font-size: 0.82rem;
    color: var(--muted);
    opacity: 0;
    transition: opacity 0.5s var(--ease-out-quint);
  }
  .game__hint[data-show="true"] {
    opacity: 1;
  }

  .game__score {
    position: absolute;
    top: clamp(1.1rem, 3.5vw, 2rem);
    left: clamp(1.1rem, 3.5vw, 2rem);
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-mono);
    font-size: 0.85rem;
    color: var(--ink);
    background: color-mix(in oklch, var(--surface) 82%, transparent);
    border: 1px solid var(--line-strong);
    border-radius: var(--radius-pill);
    padding: 0.45rem 0.9rem;
    backdrop-filter: blur(8px);
    opacity: 0;
    transform: translateY(-8px);
    pointer-events: none;
    transition:
      opacity 0.45s var(--ease-out-quint),
      transform 0.45s var(--ease-out-quint);
  }
  .game__score[data-show="true"] {
    opacity: 1;
    transform: none;
  }
  .game__score-bug {
    width: 0.6rem;
    height: 0.6rem;
    border-radius: 999px 999px 60% 60%;
    background: var(--coral);
  }
  .game__health {
    position: absolute;
    top: clamp(3.6rem, 9.5vw, 5.2rem);
    left: clamp(1.1rem, 3.5vw, 2rem);
    width: clamp(9rem, 22vw, 12rem);
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
    opacity: 0;
    transform: translateY(-8px);
    pointer-events: none;
    transition:
      opacity 0.45s var(--ease-out-quint),
      transform 0.45s var(--ease-out-quint);
  }
  .game__health[data-show="true"] {
    opacity: 1;
    transform: none;
  }
  .game__health-label {
    font-family: var(--font-mono);
    font-size: 0.64rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: color-mix(in oklch, var(--ink) 58%, transparent);
  }
  .game__health-track {
    height: 0.5rem;
    border-radius: 999px;
    background: oklch(0.3 0.02 60 / 0.45);
    border: 1px solid var(--line-strong);
    overflow: hidden;
  }
  .game__health-fill {
    display: block;
    height: 100%;
    width: 100%;
    border-radius: 999px;
    background: oklch(0.72 0.17 150);
    transition:
      width 0.18s linear,
      background-color 0.4s linear;
  }
  .game__health.is-critical .game__health-fill {
    animation: healthflash 0.6s steps(2, end) infinite;
  }
  @keyframes healthflash {
    50% {
      opacity: 0.45;
    }
  }

  /* ---- lose screen ---- */
  .game__over {
    position: absolute;
    inset: 0;
    z-index: 60;
    display: grid;
    place-items: center;
    padding: 1.5rem;
    background: oklch(0.1 0.01 50 / 0.72);
    backdrop-filter: blur(6px);
    opacity: 0;
    pointer-events: none;
    /* The game hides the OS cursor (cursor: none) in favour of the swatter,
       which is hidden here — restore a real cursor so the buttons are usable. */
    cursor: auto;
    transition: opacity 0.4s var(--ease-out-quint);
  }
  .game__over[data-show="true"] {
    opacity: 1;
    pointer-events: auto;
  }
  .game__over-card {
    width: min(92vw, 30rem);
    text-align: center;
    background: var(--surface);
    border: 1px solid var(--line-strong);
    border-radius: var(--radius-xl);
    box-shadow: var(--shadow-lg);
    padding: clamp(1.75rem, 5vw, 2.75rem);
    animation: overpop 0.45s var(--ease-out-expo);
  }
  @keyframes overpop {
    from {
      opacity: 0;
      transform: translateY(14px) scale(0.96);
    }
  }
  .game__over-eyebrow {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--coral);
    margin: 0 0 0.5rem;
  }
  .game__over-title {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: clamp(1.6rem, 5vw, 2.2rem);
    line-height: 1.05;
    color: var(--ink);
    margin: 0;
  }
  .game__over-sub {
    color: var(--muted);
    margin: 0.5rem 0 1.4rem;
    font-size: 0.95rem;
  }
  .game__over-scores {
    display: flex;
    justify-content: center;
    gap: 2.5rem;
  }
  .game__over-stat {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
  }
  .game__over-stat span {
    font-family: var(--font-mono);
    font-size: 0.66rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .game__over-stat strong {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 1.8rem;
    color: var(--coral-ink);
    font-variant-numeric: tabular-nums;
  }
  .game__over-record {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: var(--coral);
    margin: 0.45rem 0 0;
  }
  .game__over-actions {
    display: flex;
    gap: 0.75rem;
    justify-content: center;
    margin-top: 1.6rem;
  }
  .game__over-btn {
    font-family: var(--font-mono);
    font-size: 0.85rem;
    font-weight: 600;
    padding: 0.6rem 1.3rem;
    border-radius: var(--radius-pill);
    border: 1px solid var(--line-strong);
    background: transparent;
    color: var(--ink);
    cursor: pointer;
    transition:
      border-color var(--dur-fast) var(--ease-out-quint),
      transform var(--dur-fast) var(--ease-out-quint);
  }
  .game__over-btn:hover {
    border-color: var(--coral);
    transform: translateY(-1px);
  }
  .game__over-btn--primary {
    background: var(--coral);
    border-color: var(--coral);
    color: oklch(0.99 0.01 30);
  }
  .game__score strong {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 1.1rem;
    color: var(--coral-ink);
    min-width: 1.4ch;
    text-align: right;
  }

  /* ---- KILL SWITCH ---- */
  .game__killwrap {
    position: absolute;
    top: clamp(1.1rem, 3.5vw, 2rem);
    right: clamp(1.1rem, 3.5vw, 2rem);
    display: flex;
    align-items: center;
    gap: 0.6rem;
    opacity: 0;
    transform: translateY(-8px);
    pointer-events: none;
    transition:
      opacity 0.5s var(--ease-out-expo),
      transform 0.5s var(--ease-out-expo);
  }
  .game__killwrap[data-show="true"] {
    opacity: 1;
    transform: none;
    pointer-events: auto;
  }
  .game__killtip {
    font-family: var(--font-mono);
    font-size: 0.74rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    color: var(--ink);
    background: var(--surface-2);
    border: 1px solid var(--line-strong);
    padding: 0.4rem 0.7rem;
    border-radius: var(--radius-sm);
    white-space: nowrap;
    position: relative;
    opacity: 0;
    transform: translateX(8px);
    transition:
      opacity 0.35s var(--ease-out-quint),
      transform 0.35s var(--ease-out-quint);
  }
  .game__killtip::after {
    content: "";
    position: absolute;
    right: -5px;
    top: 50%;
    transform: translateY(-50%) rotate(45deg);
    width: 9px;
    height: 9px;
    background: var(--surface-2);
    border-right: 1px solid var(--line-strong);
    border-top: 1px solid var(--line-strong);
  }
  .game__killwrap[data-show="true"] .game__killtip,
  .game__killwrap:hover .game__killtip,
  .game__kill:focus-visible + .game__killtip {
    opacity: 1;
    transform: none;
  }
  .game__kill {
    flex: none;
    display: grid;
    place-items: center;
    width: 3rem;
    height: 3rem;
    border-radius: var(--radius-pill);
    background: var(--danger);
    color: oklch(0.99 0.01 30);
    border: 1px solid var(--danger-bright);
    box-shadow:
      0 0 0 0 oklch(0.58 0.21 26 / 0.6),
      0 8px 22px -8px oklch(0.58 0.21 26 / 0.8);
    cursor: pointer;
    animation: killpulse 2s ease-in-out infinite;
    transition:
      transform var(--dur-fast) var(--ease-out-quint),
      background var(--dur-fast) var(--ease-out-quint);
  }
  .game__kill:hover {
    background: var(--danger-bright);
    transform: scale(1.06);
  }
  .game__kill:active {
    transform: scale(0.94);
  }
  @keyframes killpulse {
    0%,
    100% {
      box-shadow:
        0 0 0 0 oklch(0.58 0.21 26 / 0.55),
        0 8px 22px -8px oklch(0.58 0.21 26 / 0.8);
    }
    50% {
      box-shadow:
        0 0 0 8px oklch(0.58 0.21 26 / 0),
        0 8px 22px -8px oklch(0.58 0.21 26 / 0.8);
    }
  }

  .game__swatter {
    position: absolute;
    top: 0;
    left: 0;
    width: 80px;
    height: 96px;
    margin-left: -40px;
    margin-top: -22px;
    transform: translate3d(-200px, -200px, 0) rotate(-18deg);
    will-change: transform;
    pointer-events: none;
    filter: drop-shadow(0 8px 10px oklch(0 0 0 / 0.5));
  }
  .game[data-touch="true"] .game__swatter {
    display: none;
  }
  .game__swatter[data-hidden="true"] {
    opacity: 0;
  }
  .game__swatter[data-whack="true"] {
    animation: whack 0.22s var(--ease-out-quint);
  }
  @keyframes whack {
    0% {
      scale: 1;
      rotate: -18deg;
    }
    35% {
      scale: 0.82;
      rotate: 6deg;
    }
    100% {
      scale: 1;
      rotate: -18deg;
    }
  }

  /* Floating squash toast (created per kill) */
  :global(.game__toast) {
    position: absolute;
    transform: translate(-50%, 0);
    text-align: center;
    pointer-events: none;
    z-index: 2;
    white-space: nowrap;
    background: oklch(0.96 0.012 90);
    padding: 0.5rem 0.85rem;
    border-radius: var(--radius);
    box-shadow: 0 14px 34px -14px oklch(0 0 0 / 0.65);
  }
  :global(.game__toast b) {
    display: block;
    font-family: var(--font-mono);
    font-weight: 700;
    font-size: 0.92rem;
    color: oklch(0.18 0.02 50);
  }
  :global(.game__toast b i) {
    font-style: normal;
    color: var(--coral);
    font-variant-numeric: tabular-nums;
  }
  :global(.game__toast span) {
    display: block;
    font-size: 0.76rem;
    color: oklch(0.42 0.03 55);
    margin-top: 0.05rem;
  }

  /* ---- MUTE TOGGLE ---- */
  .game__mute {
    position: absolute;
    bottom: clamp(1.1rem, 3.5vw, 2rem);
    left: clamp(1.1rem, 3.5vw, 2rem);
    display: grid;
    place-items: center;
    width: 2.6rem;
    height: 2.6rem;
    border-radius: var(--radius-pill);
    background: color-mix(in oklch, var(--surface) 82%, transparent);
    border: 1px solid var(--line-strong);
    color: var(--ink);
    backdrop-filter: blur(8px);
    cursor: pointer;
    opacity: 0;
    transform: translateY(8px);
    pointer-events: none;
    transition:
      opacity 0.45s var(--ease-out-quint),
      transform 0.45s var(--ease-out-quint),
      background var(--dur-fast) var(--ease-out-quint),
      color var(--dur-fast) var(--ease-out-quint);
  }
  .game__mute[data-show="true"] {
    opacity: 1;
    transform: none;
    pointer-events: auto;
  }
  .game__mute:hover {
    background: var(--surface-2);
  }
  .game__mute[data-muted="true"] {
    color: var(--muted);
  }
  .game__mute-slash {
    display: none;
  }
  .game__mute[data-muted="true"] .game__mute-waves {
    display: none;
  }
  .game__mute[data-muted="true"] .game__mute-slash {
    display: block;
  }

  @media (prefers-reduced-motion: reduce) {
    .game__kill {
      animation: none;
    }
  }
</style>

<script>
  import {
    TYPES, pickType, pointsFor, pickTaunt,
    drainHealth, restoreHealth, isLost, healthColor, HEALTH_MAX,
  } from "../lib/bugGame";
  import type { BugType, Severity } from "../lib/bugGame";
  import { SHAPES, drawCentipede } from "../lib/bugShapes";

  type Bug = {
    x: number;
    y: number;
    vx: number;
    vy: number;
    size: number;
    hp: number;
    maxHp: number;
    phase: number;
    legSpeed: number;
    maxSpeed: number;
    type: BugType;
    hurtAt: number;
    alpha: number;
    bornAt: number;
    taunt: string;
    hist: { x: number; y: number }[];
  };

  type Particle = {
    x: number;
    y: number;
    vx: number;
    vy: number;
    life: number;
    maxLife: number;
    size: number;
    color: string;
  };
  type Splat = { x: number; y: number; life: number; color: string; r: number };

  const el = document.querySelector<HTMLElement>("[data-game]");
  const canvas = document.querySelector<HTMLCanvasElement>("[data-game-canvas]");

  if (el && canvas) {
    const ctx = canvas.getContext("2d")!;
    const finePointer = window.matchMedia("(pointer: fine)");

    // Synthesized sound — no assets, built on the fly with the Web Audio API.
    // The context is created/resumed lazily on the first swat (a user gesture),
    // satisfying browser autoplay policy. Muting is persisted across sessions.
    const sfx = (() => {
      let audio: AudioContext | null = null;
      let master: GainNode | null = null;
      let muted = false;
      try {
        muted = localStorage.getItem("buggame:muted") === "true";
      } catch {}

      function ensure(): AudioContext | null {
        if (muted) return null;
        if (!audio) {
          const AC =
            window.AudioContext ||
            (window as unknown as { webkitAudioContext?: typeof AudioContext })
              .webkitAudioContext;
          if (!AC) return null;
          audio = new AC();
          master = audio.createGain();
          master.gain.value = 0.25;
          master.connect(audio.destination);
        }
        if (audio.state === "suspended") void audio.resume();
        return audio;
      }

      function noiseBuffer(c: AudioContext, dur: number) {
        const len = Math.floor(c.sampleRate * dur);
        const buf = c.createBuffer(1, len, c.sampleRate);
        const data = buf.getChannelData(0);
        for (let i = 0; i < len; i++) data[i] = Math.random() * 2 - 1;
        return buf;
      }

      return {
        get muted() {
          return muted;
        },
        setMuted(v: boolean) {
          muted = v;
          try {
            localStorage.setItem("buggame:muted", v ? "true" : "false");
          } catch {}
        },
        // Short, dry "thwack" — fires on every swing, so it's kept subtle.
        swat() {
          const c = ensure();
          if (!c || !master) return;
          const t = c.currentTime;
          const src = c.createBufferSource();
          src.buffer = noiseBuffer(c, 0.12);
          const lp = c.createBiquadFilter();
          lp.type = "lowpass";
          lp.frequency.setValueAtTime(1800, t);
          lp.frequency.exponentialRampToValueAtTime(300, t + 0.1);
          const g = c.createGain();
          g.gain.setValueAtTime(0.0001, t);
          g.gain.exponentialRampToValueAtTime(0.5, t + 0.005);
          g.gain.exponentialRampToValueAtTime(0.0001, t + 0.11);
          src.connect(lp).connect(g).connect(master);
          src.start(t);
          src.stop(t + 0.12);
        },
        // Wetter "splat" with a downward pop — the payoff, only on a kill.
        squash() {
          const c = ensure();
          if (!c || !master) return;
          const t = c.currentTime;
          const src = c.createBufferSource();
          src.buffer = noiseBuffer(c, 0.2);
          const lp = c.createBiquadFilter();
          lp.type = "lowpass";
          lp.frequency.setValueAtTime(2600, t);
          lp.frequency.exponentialRampToValueAtTime(200, t + 0.18);
          const ng = c.createGain();
          ng.gain.setValueAtTime(0.0001, t);
          ng.gain.exponentialRampToValueAtTime(0.7, t + 0.006);
          ng.gain.exponentialRampToValueAtTime(0.0001, t + 0.19);
          src.connect(lp).connect(ng).connect(master);
          src.start(t);
          src.stop(t + 0.2);

          const osc = c.createOscillator();
          osc.type = "triangle";
          osc.frequency.setValueAtTime(420, t);
          osc.frequency.exponentialRampToValueAtTime(70, t + 0.16);
          const og = c.createGain();
          og.gain.setValueAtTime(0.0001, t);
          og.gain.exponentialRampToValueAtTime(0.6, t + 0.008);
          og.gain.exponentialRampToValueAtTime(0.0001, t + 0.17);
          osc.connect(og).connect(master);
          osc.start(t);
          osc.stop(t + 0.18);
        },
      };
    })();

    const promptEl = el.querySelector<HTMLElement>("[data-game-prompt]")!;
    const hintEl = el.querySelector<HTMLElement>("[data-game-hint]")!;
    const killWrap = el.querySelector<HTMLElement>("[data-killwrap]")!;
    const scoreEl = el.querySelector<HTMLElement>("[data-game-score]")!;
    const scoreVal = el.querySelector<HTMLElement>("[data-game-score-value]")!;
    const healthEl = el.querySelector<HTMLElement>("[data-health]")!;
    const healthFill = el.querySelector<HTMLElement>("[data-health-fill]")!;
    const loseEl = el.querySelector<HTMLElement>("[data-lose]")!;
    const loseScore = el.querySelector<HTMLElement>("[data-lose-score]")!;
    const loseBest = el.querySelector<HTMLElement>("[data-lose-best]")!;
    const loseRecord = el.querySelector<HTMLElement>("[data-lose-record]")!;
    const loseReplay = el.querySelector<HTMLButtonElement>("[data-lose-replay]")!;
    const loseHome = el.querySelector<HTMLButtonElement>("[data-lose-home]")!;

    const BEST_KEY = "hiren:bestscore";
    const getBest = (): number => {
      try {
        return parseInt(localStorage.getItem(BEST_KEY) || "0", 10) || 0;
      } catch {
        return 0;
      }
    };
    const setBest = (v: number): void => {
      try {
        localStorage.setItem(BEST_KEY, String(v));
      } catch {}
    };
    const killBtn = el.querySelector<HTMLButtonElement>("[data-game-kill]")!;
    const swatter = el.querySelector<HTMLElement>("[data-game-swatter]")!;
    const muteBtn = el.querySelector<HTMLButtonElement>("[data-game-mute]")!;

    function syncMute() {
      muteBtn.dataset.muted = sfx.muted ? "true" : "false";
      muteBtn.setAttribute("aria-pressed", sfx.muted ? "true" : "false");
      muteBtn.setAttribute("aria-label", sfx.muted ? "Unmute sound" : "Mute sound");
    }
    syncMute();

    let open = false;
    let raf = 0;
    let w = 0;
    let h = 0;
    let lastT = 0;
    let squashed = 0;
    let score = 0;
    let health = HEALTH_MAX;
    let lost = false;

    function renderHealth() {
      healthFill.style.width = `${health}%`;
      healthFill.style.backgroundColor = healthColor(health);
      healthEl.classList.toggle("is-critical", health < 45);
    }
    let needToReveal = 3;
    let killShown = false;
    let scattering = false;
    let spawnTimer = 0;
    let spawnEvery = 950;
    let pointerX = -300;
    let pointerY = -300;
    let lastFocus: HTMLElement | null = null;

    const bugs: Bug[] = [];
    const particles: Particle[] = [];
    const splats: Splat[] = [];
    const isTouch = !finePointer.matches;

    const rand = (a: number, b: number) => a + Math.random() * (b - a);

    function resize() {
      const dpr = Math.min(window.devicePixelRatio || 1, 2);
      w = window.innerWidth;
      h = window.innerHeight;
      canvas!.width = Math.floor(w * dpr);
      canvas!.height = Math.floor(h * dpr);
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
    }

    function spawnBug(type: BugType) {
      const base = Math.min(w, h);
      const size = (base < 600 ? 30 : 38) * type.sizeMul;
      const margin = size + 16;
      const edge = Math.floor(rand(0, 4));
      let x: number, y: number;
      if (edge === 0) (x = rand(margin, w - margin)), (y = margin);
      else if (edge === 1) (x = w - margin), (y = rand(margin, h - margin));
      else if (edge === 2) (x = rand(margin, w - margin)), (y = h - margin);
      else (x = margin), (y = rand(margin, h - margin));
      const speed = rand(0.06, 0.1) * base * 0.012 * type.speedMul;
      const dir = rand(0, Math.PI * 2);
      bugs.push({
        x, y,
        vx: Math.cos(dir) * speed,
        vy: Math.sin(dir) * speed,
        size,
        hp: type.hp,
        maxHp: type.hp,
        phase: rand(0, Math.PI * 2),
        legSpeed: rand(0.8, 1.3),
        maxSpeed: speed * 1.9,
        type,
        hurtAt: -9999,
        alpha: 1,
        bornAt: performance.now(),
        taunt: `${type.name}: ${pickTaunt(type.severity)}`,
        hist: [],
      });
    }

    function drawBug(b: Bug, t: number) {
      const c = ctx;
      const s = b.size;
      const hurt = t - b.hurtAt < 140;
      // Centipede draws itself in world space from its trail (no body rotate).
      if (b.type.shape === "centipede") {
        const hist = b.hist.length ? b.hist : [{ x: b.x, y: b.y }];
        drawCentipede(c, hist, s, hurt ? "oklch(0.97 0.04 90)" : b.type.color, b.type.spot, t);
        return;
      }
      c.save();
      c.globalAlpha = b.alpha;
      c.translate(b.x, b.y);
      c.rotate(Math.atan2(b.vy, b.vx) + Math.PI / 2);
      const swing = Math.sin(t * 0.012 * b.legSpeed + b.phase) * 0.32;
      const flap = 0.25 + 0.85 * Math.abs(Math.sin(t * 0.09 + b.phase));
      // Flash a clone (not the shared TYPES object) when hit.
      const drawType = hurt ? { ...b.type, color: "oklch(0.97 0.04 90)" } : b.type;
      SHAPES[b.type.shape as Exclude<BugType["shape"], "centipede">](c, s, drawType, swing, flap);

      // HP pips for multi-hit bugs
      if (b.maxHp > 1) {
        c.fillStyle = "oklch(0.2 0.02 55 / 0.8)";
        for (let i = 0; i < b.hp; i++) {
          c.beginPath();
          c.arc((i - (b.hp - 1) / 2) * s * 0.2, s * 0.12, s * 0.05, 0, Math.PI * 2);
          c.fill();
        }
      }
      c.restore();
    }

    function floatToast(x: number, y: number, name: string, line: string, points: number) {
      const node = document.createElement("div");
      node.className = "game__toast";
      node.style.left = `${x}px`;
      node.style.top = `${y - 24}px`;
      const pts = points > 0 ? ` <i>+${points}</i>` : "";
      node.innerHTML = `<b>${name}${pts}</b><span>${line}</span>`;
      el!.appendChild(node);
      node
        .animate(
          [
            { opacity: 0, transform: "translate(-50%, 8px) scale(0.85)" },
            { opacity: 1, transform: "translate(-50%, -4px) scale(1)", offset: 0.12 },
            { opacity: 1, transform: "translate(-50%, -28px) scale(1)", offset: 0.72 },
            { opacity: 0, transform: "translate(-50%, -64px) scale(1)" },
          ],
          { duration: 2200, easing: "cubic-bezier(0.16,1,0.3,1)" }
        )
        .finished.then(() => node.remove())
        .catch(() => node.remove());
    }

    function squash(b: Bug) {
      sfx.squash();
      splats.push({ x: b.x, y: b.y, life: 1, color: b.type.color, r: b.size * 0.9 });
      for (let i = 0; i < 14; i++) {
        const a = rand(0, Math.PI * 2);
        const sp = rand(1, 5);
        particles.push({
          x: b.x, y: b.y,
          vx: Math.cos(a) * sp,
          vy: Math.sin(a) * sp - 1.5,
          life: 1,
          maxLife: rand(0.5, 0.9),
          size: rand(2, 5),
          color: Math.random() > 0.5 ? b.type.color : b.type.spot,
        });
      }
      const idx = bugs.indexOf(b);
      if (idx >= 0) bugs.splice(idx, 1);
      floatToast(b.x, b.y, b.type.name, pickTaunt(b.type.severity), pointsFor(b.type.severity));

      squashed++;
      score += pointsFor(b.type.severity);
      scoreVal.textContent = String(score);
      health = restoreHealth(health, b.type.severity);
      renderHealth();
      scoreEl.animate(
        [{ transform: "scale(1)" }, { transform: "scale(1.14)" }, { transform: "scale(1)" }],
        { duration: 240, easing: "ease-out" }
      );
      spawnEvery = Math.max(520, spawnEvery - 16);
      if (!killShown && squashed >= needToReveal) revealKill();
    }

    function revealKill() {
      killShown = true;
      killWrap.dataset.show = "true";
    }

    function hit(x: number, y: number) {
      if (lost) return;
      sfx.swat();
      if (!isTouch) {
        swatter.dataset.whack = "true";
        setTimeout(() => (swatter.dataset.whack = "false"), 220);
      } else {
        ripple(x, y);
      }
      let best: Bug | null = null;
      let bestD = Infinity;
      for (const b of bugs) {
        let d: number;
        if (b.type.shape === "centipede" && b.hist.length) {
          d = Infinity;
          for (let k = 0; k < b.hist.length; k += 10) {
            d = Math.min(d, Math.hypot(b.hist[k].x - x, b.hist[k].y - y));
          }
        } else {
          d = Math.hypot(b.x - x, b.y - y);
        }
        const tol = b.size * 0.95 + 16;
        if (d < tol && d < bestD) (best = b), (bestD = d);
      }
      if (!best) return;
      if (best.type.ignoresHit && best.hp === best.maxHp && Math.random() < 0.35) {
        best.hurtAt = performance.now();
        return;
      }
      best.hp--;
      best.hurtAt = performance.now();
      if (best.hp <= 0) squash(best);
    }

    function ripple(x: number, y: number) {
      const r = document.createElement("span");
      r.style.cssText = `position:absolute;left:${x}px;top:${y}px;width:8px;height:8px;margin:-4px 0 0 -4px;border-radius:999px;border:2px solid var(--coral);pointer-events:none;`;
      el!.appendChild(r);
      r.animate(
        [
          { transform: "scale(1)", opacity: 0.9 },
          { transform: "scale(7)", opacity: 0 },
        ],
        { duration: 420, easing: "cubic-bezier(0.16,1,0.3,1)" }
      ).finished.then(() => r.remove()).catch(() => r.remove());
    }

    let promptTimer = 0;
    function showPrompt(text: string, hold = 1600) {
      promptEl.textContent = text;
      promptEl.dataset.show = "true";
      window.clearTimeout(promptTimer);
      if (hold > 0) promptTimer = window.setTimeout(() => (promptEl.dataset.show = "false"), hold);
    }

    // Keep bugs from overlapping: push apart and turn each away on contact.
    function resolveCollisions() {
      for (let it = 0; it < 2; it++) {
        for (let i = 0; i < bugs.length; i++) {
          for (let j = i + 1; j < bugs.length; j++) {
            const a = bugs[i], b = bugs[j];
            const dx = b.x - a.x, dy = b.y - a.y;
            const d = Math.hypot(dx, dy) || 0.001;
            const min = a.size * 0.62 + b.size * 0.62;
            if (d < min) {
              const nx = dx / d, ny = dy / d, push = (min - d) / 2;
              a.x -= nx * push; a.y -= ny * push;
              b.x += nx * push; b.y += ny * push;
              const sa = Math.hypot(a.vx, a.vy), sb = Math.hypot(b.vx, b.vy);
              a.vx = -nx * sa; a.vy = -ny * sa;
              b.vx = nx * sb; b.vy = ny * sb;
            }
          }
        }
      }
    }

    function update(dt: number, t: number) {
      for (const b of bugs) {
        if (scattering) {
          // same speed + heading as in-game play — just don't bounce, walk out
          b.x += b.vx * dt * 0.06;
          b.y += b.vy * dt * 0.06;
          continue;
        }
        if (Math.random() < 0.03) {
          const a = Math.atan2(b.vy, b.vx) + rand(-0.6, 0.6);
          const sp = Math.hypot(b.vx, b.vy);
          b.vx = Math.cos(a) * sp;
          b.vy = Math.sin(a) * sp;
        }
        if (b.type.speedMul > 1.4 && Math.random() < 0.008) {
          b.vx *= 1.3;
          b.vy *= 1.3;
        }
        // keep speed bounded so the Race Condition can't run away
        const sp = Math.hypot(b.vx, b.vy);
        if (sp > b.maxSpeed) {
          b.vx = (b.vx / sp) * b.maxSpeed;
          b.vy = (b.vy / sp) * b.maxSpeed;
        }
        if (b.type.dodges && !isTouch) {
          const d = Math.hypot(b.x - pointerX, b.y - pointerY);
          if (d < b.size * 2.4) {
            const a = Math.atan2(b.y - pointerY, b.x - pointerX);
            b.x += Math.cos(a) * b.size * 2.2;
            b.y += Math.sin(a) * b.size * 2.2;
          }
        }
        if (b.type.grows) b.size = Math.min(b.size + dt * 0.004, 64);
        if (b.type.flickers) b.alpha = 0.45 + 0.55 * (0.5 + 0.5 * Math.sin(t * 0.006 + b.phase));

        b.x += b.vx * dt * 0.06;
        b.y += b.vy * dt * 0.06;
        const m = b.size + 6;
        if (b.x < m) (b.x = m), (b.vx = Math.abs(b.vx));
        if (b.x > w - m) (b.x = w - m), (b.vx = -Math.abs(b.vx));
        if (b.y < m) (b.y = m), (b.vy = Math.abs(b.vy));
        if (b.y > h - m) (b.y = h - m), (b.vy = -Math.abs(b.vy));
      }

      if (!scattering) resolveCollisions();
      for (const b of bugs) {
        if (b.type.shape === "centipede") {
          b.hist.unshift({ x: b.x, y: b.y });
          if (b.hist.length > 260) b.hist.pop();
        }
      }

      // Living bugs drain System health; dropping into the red loses the run.
      if (!scattering && bugs.length) {
        health = drainHealth(health, bugs.map((b) => b.type.severity) as Severity[], dt);
        renderHealth();
        if (isLost(health)) {
          loseGame();
          return;
        }
      }

      if (scattering) {
        for (let i = bugs.length - 1; i >= 0; i--) {
          const b = bugs[i];
          const m = b.size + 80;
          if (b.x < -m || b.x > w + m || b.y < -m || b.y > h + m) bugs.splice(i, 1);
        }
        if (bugs.length === 0) closeGame();
      }

      for (let i = particles.length - 1; i >= 0; i--) {
        const p = particles[i];
        p.x += p.vx;
        p.y += p.vy;
        p.vy += 0.35;
        p.life -= dt / 1000 / p.maxLife;
        if (p.life <= 0) particles.splice(i, 1);
      }
      for (let i = splats.length - 1; i >= 0; i--) {
        splats[i].life -= dt / 1400;
        if (splats[i].life <= 0) splats.splice(i, 1);
      }

      if (!scattering) {
        spawnTimer += dt;
        const cap = w < 640 ? 7 : 12;
        if (spawnTimer > spawnEvery && bugs.length < cap) {
          spawnTimer = 0;
          const hasBlocker = bugs.some((b) => b.type.severity === 0);
          spawnBug(pickType({ squashed, hasBlocker }));
        }
      }
    }

    function render(t: number) {
      const c = ctx;
      c.clearRect(0, 0, w, h);
      for (const sp of splats) {
        c.save();
        c.globalAlpha = sp.life * 0.4;
        c.fillStyle = sp.color;
        c.beginPath();
        c.ellipse(sp.x, sp.y, sp.r * (1.4 - sp.life * 0.4), sp.r * 0.7, 0, 0, Math.PI * 2);
        c.fill();
        c.restore();
      }
      for (const b of bugs) drawBug(b, t);
      for (const p of particles) {
        c.save();
        c.globalAlpha = Math.max(0, p.life);
        c.fillStyle = p.color;
        c.beginPath();
        c.arc(p.x, p.y, p.size, 0, Math.PI * 2);
        c.fill();
        c.restore();
      }
      // Speech bubbles drawn last so they sit above every bug.
      if (!scattering) for (const b of bugs) drawTaunt(b, t);
    }

    // Wrap text to a max pixel width, returning the lines.
    function wrapText(text: string, maxW: number): string[] {
      const words = text.split(" ");
      const lines: string[] = [];
      let line = "";
      for (const word of words) {
        const next = line ? `${line} ${word}` : word;
        if (ctx.measureText(next).width > maxW && line) {
          lines.push(line);
          line = word;
        } else {
          line = next;
        }
      }
      if (line) lines.push(line);
      return lines;
    }

    // A speech-bubble taunt that fades in once a bug has roamed for ~5s, holds,
    // then fades out — like the bug is talking to the player.
    function drawTaunt(b: Bug, t: number) {
      const age = t - b.bornAt;
      if (age < 5000 || age > 10000) return;
      let alpha = 1;
      if (age < 5450) alpha = (age - 5000) / 450;
      else if (age > 9400) alpha = 1 - (age - 9400) / 600;
      alpha = Math.max(0, Math.min(1, alpha));
      if (alpha <= 0) return;

      const c = ctx;
      c.save();
      c.font = '600 13px ui-sans-serif, system-ui, -apple-system, sans-serif';
      const padX = 11;
      const padY = 8;
      const lineH = 17;
      const maxW = Math.min(w * 0.5, 240);
      const lines = wrapText(b.taunt, maxW);
      let textW = 0;
      for (const ln of lines) textW = Math.max(textW, c.measureText(ln).width);
      const bw = textW + padX * 2;
      const bh = lines.length * lineH + padY * 2;
      let bx = b.x - bw / 2;
      bx = Math.max(6, Math.min(w - bw - 6, bx));
      const by = Math.max(6, b.y - b.size * 0.85 - bh - 10);

      c.globalAlpha = alpha;
      // bubble + downward tail toward the bug
      c.fillStyle = "oklch(0.96 0.02 95)";
      c.beginPath();
      c.roundRect(bx, by, bw, bh, 11);
      c.fill();
      const tailX = Math.max(bx + 14, Math.min(bx + bw - 14, b.x));
      c.beginPath();
      c.moveTo(tailX - 7, by + bh - 1);
      c.lineTo(tailX, by + bh + 9);
      c.lineTo(tailX + 7, by + bh - 1);
      c.closePath();
      c.fill();
      // text
      c.fillStyle = "oklch(0.22 0.02 50)";
      c.textAlign = "left";
      c.textBaseline = "middle";
      lines.forEach((ln, i) => {
        c.fillText(ln, bx + padX, by + padY + lineH / 2 + i * lineH);
      });
      c.restore();
    }

    function loop(t: number) {
      if (!open) return;
      const dt = Math.min(t - lastT, 48);
      lastT = t;
      update(dt, t);
      render(t);
      raf = requestAnimationFrame(loop);
    }

    function lockScroll(lock: boolean) {
      document.documentElement.style.overflow = lock ? "hidden" : "";
    }

    function openGame(killNow: boolean) {
      if (open) return;
      open = true;
      scattering = false;
      lastFocus = document.activeElement as HTMLElement;
      resize();
      bugs.length = particles.length = splats.length = 0;
      squashed = 0;
      score = 0;
      scoreVal.textContent = "0";
      scoreEl.dataset.show = "false";
      health = HEALTH_MAX;
      renderHealth();
      healthEl.dataset.show = "false";
      lost = false;
      loseEl.dataset.show = "false";
      spawnEvery = 950;
      spawnTimer = 0;
      killShown = false;
      needToReveal = killNow ? 0 : 3;

      el!.hidden = false;
      el!.setAttribute("aria-hidden", "false");
      el!.dataset.touch = isTouch ? "true" : "false";
      el!.dataset.scatter = "false";
      killWrap.dataset.show = "false";
      muteBtn.dataset.show = "true";
      lockScroll(true);
      void el!.offsetWidth;
      el!.dataset.open = "true";
      document.documentElement.classList.add("game-on");

      // Show the message on a clean stage, hold it ~2s, then let the bugs in.
      showPrompt("Let's squash some bugs.", 2300);
      hintEl.textContent = isTouch ? "tap the bugs" : "swat the bugs — the tough ones take a few";
      window.setTimeout(() => {
        if (!open) return;
        spawnBug(TYPES.find((t) => t.name === "Typo")!);
        spawnBug(TYPES.find((t) => t.name === "Off-by-One")!);
        scoreEl.dataset.show = "true";
        healthEl.dataset.show = "true";
      }, 2300);
      window.setTimeout(() => {
        if (open) hintEl.dataset.show = "true";
      }, 2600);
      window.setTimeout(() => (hintEl.dataset.show = "false"), 6200);

      if (killNow) {
        revealKill();
        killBtn.focus({ preventScroll: true });
      }
      lastT = performance.now();
      raf = requestAnimationFrame(loop);
    }

    function loseGame() {
      if (lost || scattering) return;
      lost = true;
      cancelAnimationFrame(raf); // freeze the board behind the lose card
      scoreEl.dataset.show = "false";
      healthEl.dataset.show = "false";
      killWrap.dataset.show = "false";
      muteBtn.dataset.show = "false";
      swatter.dataset.hidden = "true";
      promptEl.dataset.show = "false";
      hintEl.dataset.show = "false";

      const prevBest = getBest();
      const record = score > prevBest;
      if (record) setBest(score);
      loseScore.textContent = String(score);
      loseBest.textContent = String(Math.max(prevBest, score));
      loseRecord.hidden = !record;
      loseEl.dataset.show = "true";
      loseReplay.focus({ preventScroll: true });
    }

    function replayGame() {
      loseEl.dataset.show = "false";
      lost = false;
      open = false; // let openGame re-initialise (it early-returns when open)
      openGame(false);
    }

    function exitToHome() {
      loseEl.dataset.show = "false";
      lost = false;
      // Reveal the page like a normal game end (stage-revealed + overlay close).
      document.dispatchEvent(new CustomEvent("game:cleared"));
      closeGame();
    }

    function killSwitch() {
      if (!open || scattering || lost) return;
      scattering = true;
      el!.dataset.scatter = "true"; // fade the overlay so the page loads in beneath
      swatter.dataset.hidden = "true";
      hintEl.dataset.show = "false";
      promptEl.dataset.show = "false";
      killWrap.dataset.show = "false";
      scoreEl.dataset.show = "false";
      healthEl.dataset.show = "false";
      muteBtn.dataset.show = "false";
      // bugs keep their exact in-game speed + heading; they just walk off-screen
      document.dispatchEvent(new CustomEvent("game:cleared"));
      // Don't cut them off — closeGame runs from the loop once every bug has
      // actually left the window. This is only a far backstop (e.g. a hidden tab).
      window.setTimeout(() => closeGame(), 30000);
    }

    function closeGame() {
      if (!open) return;
      open = false;
      cancelAnimationFrame(raf);
      el!.dataset.open = "false";
      el!.setAttribute("aria-hidden", "true");
      document.documentElement.classList.remove("game-on");
      lockScroll(false);
      // Every bug has left the window (or the backstop fired) — the game is done.
      document.dispatchEvent(new CustomEvent("game:closed"));
      window.setTimeout(() => {
        if (!open) {
          el!.hidden = true;
          bugs.length = particles.length = splats.length = 0;
        }
      }, 420);
    }

    // ---- input ----
    const overControl = (t: EventTarget | null) =>
      t instanceof Element && !!t.closest("[data-game-control]");

    el.addEventListener("pointermove", (e) => {
      pointerX = e.clientX;
      pointerY = e.clientY;
      if (!isTouch) {
        if (overControl(e.target)) {
          swatter.dataset.hidden = "true";
        } else {
          swatter.dataset.hidden = "false";
          swatter.style.transform = `translate3d(${e.clientX}px, ${e.clientY}px, 0) rotate(-18deg)`;
        }
      }
    });
    el.addEventListener("pointerdown", (e) => {
      if (lost || scattering || overControl(e.target)) return;
      e.preventDefault();
      pointerX = e.clientX;
      pointerY = e.clientY;
      if (!isTouch) {
        swatter.style.transform = `translate3d(${e.clientX}px, ${e.clientY}px, 0) rotate(-18deg)`;
      }
      hit(e.clientX, e.clientY);
    });

    killBtn.addEventListener("click", killSwitch);
    loseReplay.addEventListener("click", replayGame);
    loseHome.addEventListener("click", exitToHome);
    muteBtn.addEventListener("click", () => {
      sfx.setMuted(!sfx.muted);
      syncMute();
    });
    el.addEventListener("keydown", (e) => {
      if (e.key === "Escape" && killShown) killSwitch();
    });
    window.addEventListener("resize", () => {
      if (open) resize();
    });

    // ---- external control ----
    document.addEventListener("game:open", (e) => {
      const killNow = !!(e as CustomEvent).detail?.killNow;
      openGame(killNow);
    });
    void lastFocus;

    // Auto-start the game-first flow. Self-contained so there is no cross-script
    // event race for the initial open (the <head> arms `game-armed`).
    function autostart() {
      if (document.documentElement.classList.contains("game-armed")) openGame(false);
    }
    if (document.readyState === "loading")
      document.addEventListener("DOMContentLoaded", autostart);
    else autostart();
  }
</script>
