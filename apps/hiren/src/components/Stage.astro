  /* badges */
  .badge {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-family: var(--font-mono);
    font-size: 0.68rem;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    padding: 0.26rem 0.6rem 0.26rem 0.5rem;
    border-radius: var(--radius-pill);
    border: 1px solid transparent;
  }
  .badge__dot {
    width: 0.42rem;
    height: 0.42rem;
    border-radius: 999px;
  }
  .badge--coral { background: var(--wash-coral); color: var(--coral-ink); border-color: color-mix(in oklch, var(--coral) 35%, transparent); }
  .badge--coral .badge__dot { background: var(--coral); }
  .badge--sun { background: var(--wash-sun); color: var(--sun); border-color: color-mix(in oklch, var(--sun) 35%, transparent); }
  .badge--sun .badge__dot { background: var(--sun); }
  .badge--leaf { background: var(--wash-leaf); color: var(--leaf); border-color: color-mix(in oklch, var(--leaf) 32%, transparent); }
  .badge--leaf .badge__dot { background: var(--leaf); }
  .badge--muted { background: var(--surface-2); color: var(--muted); border-color: var(--line); }
  .badge--muted .badge__dot { background: var(--muted); }

  @media (max-width: 640px) {
    .ditem {
      grid-template-columns: 1fr;
      gap: 1rem;
    }
  }

  /* ============== Enhanced mode: game-first + modal pop-ups ============== */
  html.game-armed .topbar {
    opacity: 0;
    transform: translateY(-8px);
    pointer-events: none;
    transition: opacity var(--dur-slow) var(--ease-out-quint), transform var(--dur-slow) var(--ease-out-quint);
  }
  html.game-armed.game-done .topbar {
    opacity: 1;
    transform: none;
    pointer-events: auto;
  }

  html.game-armed .hub {
    opacity: 0;
    transform: scale(0.97);
    pointer-events: none;
  }
  html.game-armed.stage-revealed .hub {
    opacity: 1;
    transform: none;
    pointer-events: auto;
    transition: opacity var(--dur-slow) var(--ease-out-expo), transform var(--dur-slow) var(--ease-out-expo);
  }
  /* Hero text fades in. */
  html.game-armed.stage-revealed .hub__kicker,
  html.game-armed.stage-revealed .status,
  html.game-armed.stage-revealed .hub__name,
  html.game-armed.stage-revealed .hub__tag,
  html.game-armed.stage-revealed .hub__loc {
    animation: fadein 0.85s var(--ease-out-expo) backwards;
  }
  html.game-armed.stage-revealed .hub__name { animation-delay: 0.12s; }
  html.game-armed.stage-revealed .hub__tag { animation-delay: 0.24s; }
  html.game-armed.stage-revealed .hub__loc { animation-delay: 0.32s; }

  /* The four boxes slide up, one after another. */
  html.game-armed.stage-revealed .hub__links .framelink {
    animation: slideup 0.65s var(--ease-out-expo) backwards;
  }
  html.game-armed.stage-revealed .hub__links .framelink:nth-child(1) { animation-delay: 0.4s; }
  html.game-armed.stage-revealed .hub__links .framelink:nth-child(2) { animation-delay: 0.49s; }
  html.game-armed.stage-revealed .hub__links .framelink:nth-child(3) { animation-delay: 0.58s; }
  html.game-armed.stage-revealed .hub__links .framelink:nth-child(4) { animation-delay: 0.67s; }

  /* Contact icons pop in. */
  html.game-armed.stage-revealed .cicon {
    animation: popin 0.55s var(--ease-spring) backwards;
  }
  html.game-armed.stage-revealed .cicon:nth-child(1) { animation-delay: 0.74s; }
  html.game-armed.stage-revealed .cicon:nth-child(2) { animation-delay: 0.82s; }
  html.game-armed.stage-revealed .cicon:nth-child(3) { animation-delay: 0.9s; }
  html.game-armed.stage-revealed .cicon:nth-child(4) { animation-delay: 0.98s; }

  @keyframes fadein {
    from {
      opacity: 0;
      transform: translateY(8px);
    }
  }
  @keyframes slideup {
    from {
      opacity: 0;
      transform: translateY(32px);
    }
  }
  @keyframes popin {
    from {
      opacity: 0;
      transform: scale(0.3) translateY(6px);
    }
  }

  /* panels become centered 80% modals */
  html.game-armed .panel {
    position: fixed;
    inset: 0;
    z-index: var(--z-panel);
    margin: 0;
    border-top: 0;
    padding: clamp(1rem, 4vw, 2.5rem);
    display: none;
    place-items: center;
    background: oklch(0.1 0.01 50 / 0.62);
    backdrop-filter: blur(4px);
  }
  html.game-armed .panel.is-active {
    display: grid;
    animation: modalin 0.4s var(--ease-out-expo);
  }
  @keyframes modalin {
    from {
      opacity: 0;
    }
  }
  html.game-armed .panel__inner {
    width: min(80vw, 70rem);
    height: 80vh;
    max-width: none;
    margin: 0;
    overflow-y: auto;
    overscroll-behavior: contain;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius-xl);
    box-shadow: var(--shadow-lg);
    padding: clamp(1.75rem, 4vw, 3rem);
    position: relative;
    animation: cardin 0.45s var(--ease-out-expo);
  }
  @keyframes cardin {
    from {
      opacity: 0;
      transform: translateY(14px) scale(0.98);
    }
  }
  html.game-armed .panel__inner--picker {
    display: flex;
    flex-direction: column;
    overflow: hidden;
  }
  html.game-armed .panel__inner--picker .picker {
    flex: 1;
    min-height: 0;
  }
  html.game-armed .panel__inner--picker .picker__detail {
    overflow-y: auto;
  }
  html.game-armed .panel__back {
    display: inline-flex;
    position: absolute;
    top: clamp(1rem, 2.5vw, 1.5rem);
    right: clamp(1rem, 2.5vw, 1.5rem);
    z-index: 2;
  }
  html.game-armed .panel__title {
    padding-right: 5rem;
  }

  @media (max-width: 700px) {
    html.game-armed .panel__inner {
      width: 94vw;
      height: 88vh;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .marquee__track,
    .picker__track,
    .framelink,
    .ditem.is-active {
      animation: none !important;
      transition: none !important;
    }
    .marquee,
    .picker__marquee {
      overflow-x: auto;
    }
    .status__dot {
      animation: none !important;
    }
    html.game-armed.stage-revealed .hub__kicker,
    html.game-armed.stage-revealed .status,
    html.game-armed.stage-revealed .hub__name,
    html.game-armed.stage-revealed .hub__tag,
    html.game-armed.stage-revealed .hub__loc,
    html.game-armed.stage-revealed .hub__links .framelink,
    html.game-armed.stage-revealed .cicon {
      animation: none !important;
    }
  }
</style>

<script>
  const html = document.documentElement;
  const stage = document.querySelector<HTMLElement>("[data-stage]");
  if (stage) {
    const armed = html.classList.contains("game-armed");

    // ---- modals (About / Experience / Projects) ----
    const panels = new Map<string, HTMLElement>();
    stage.querySelectorAll<HTMLElement>("[data-panel-view]").forEach((p) => panels.set(p.dataset.panelView!, p));
    let active: HTMLElement | null = null;
    let lastTrigger: HTMLElement | null = null;

    function openPanel(id: string, trigger?: HTMLElement) {
      const p = panels.get(id);
      if (!p || !armed) return;
      if (active && active !== p) active.classList.remove("is-active");
      p.classList.add("is-active");
      active = p;
      lastTrigger = trigger ?? null;
      // Now that the panel is laid out, (re)measure its marquees.
      requestAnimationFrame(() =>
        p.querySelectorAll<HTMLElement>("[data-pick-marquee]").forEach(layoutPickMarquee)
      );
      const inner = p.querySelector<HTMLElement>(".panel__inner");
      if (inner) inner.scrollTop = 0;
      p.querySelector<HTMLElement>("[data-panel-close]")?.focus({ preventScroll: true });
    }
    function closePanel() {
      if (!active) return;
      active.classList.remove("is-active");
      const t = lastTrigger;
      active = null;
      t?.focus?.({ preventScroll: true });
    }

    stage.querySelectorAll<HTMLAnchorElement>("[data-panel-link]").forEach((a) =>
      a.addEventListener("click", (e) => {
        if (!armed) return;
        e.preventDefault();
        openPanel(a.dataset.panelLink!, a);
      })
    );
    stage.querySelectorAll<HTMLElement>("[data-panel-close]").forEach((b) => b.addEventListener("click", closePanel));
    panels.forEach((p) =>
      p.addEventListener("click", (e) => {
        if (e.target === p) closePanel(); // click the backdrop
      })
    );
    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape" && active) closePanel();
    });

    // ---- pickers: hover a marquee logo -> fill the detail ----
    // Delegated so cloned (looping) logos stay interactive too.
    stage.querySelectorAll<HTMLElement>("[data-picker]").forEach((pk) => {
      const items = Array.from(pk.querySelectorAll<HTMLElement>("[data-ditem]"));
      const select = (i: number) => items.forEach((it, j) => it.classList.toggle("is-active", j === i));
      const fromEvent = (e: Event) => {
        const btn = (e.target as HTMLElement).closest<HTMLElement>("[data-pick]");
        if (btn) select(parseInt(btn.dataset.pick!, 10));
      };
      pk.addEventListener("mouseover", fromEvent);
      pk.addEventListener("focusin", fromEvent);
      pk.addEventListener("click", fromEvent);
    });

    // ---- experience / projects marquee: single occurrence + dynamic fade ----
    // Each company/project is rendered once. If the row fits its container we
    // center it statically (no repeats, no fade). If it overflows we clone one
    // set for a seamless loop where only a single occurrence is ever on screen,
    // and size the side fade to the overflow so it grows/shrinks with the count.
    const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)");
    const pickMarquees = Array.from(stage.querySelectorAll<HTMLElement>("[data-pick-marquee]"));

    function layoutPickMarquee(marquee: HTMLElement) {
      const track = marquee.querySelector<HTMLElement>(".picker__track");
      if (!track) return;

      // Reset to a clean single-set, static-measurable state.
      track.querySelectorAll<HTMLElement>("[data-clone]").forEach((n) => n.remove());
      marquee.classList.remove("is-static", "is-scroll", "is-scrollable");
      marquee.style.setProperty("--fade", "0px");

      // Hidden (e.g. a modal that isn't open yet) — can't measure; try later.
      if (marquee.clientWidth === 0) return;

      const overflow = track.scrollWidth - marquee.clientWidth;
      if (overflow <= 1) {
        marquee.classList.add("is-static");
        return;
      }

      // Fade scales with how much content runs off the edges (≈ item count),
      // clamped so it never swallows a whole logo or vanishes entirely.
      const fade = Math.round(Math.min(Math.max(overflow * 0.22, 24), 72));
      marquee.style.setProperty("--fade", `${fade}px`);

      if (reduceMotion.matches) {
        marquee.classList.add("is-scrollable");
        return;
      }

      // Clone one set so translateX(-50%) loops seamlessly.
      marquee.classList.add("is-scroll");
      Array.from(track.children).forEach((li) => {
        const clone = li.cloneNode(true) as HTMLElement;
        clone.setAttribute("data-clone", "");
        clone.setAttribute("aria-hidden", "true");
        track.appendChild(clone);
      });
    }

    const layoutAllPickers = () => pickMarquees.forEach(layoutPickMarquee);
    layoutAllPickers();

    let resizeRaf = 0;
    window.addEventListener("resize", () => {
      cancelAnimationFrame(resizeRaf);
      resizeRaf = requestAnimationFrame(layoutAllPickers);
    });
    reduceMotion.addEventListener?.("change", layoutAllPickers);

    // ---- tools toggle + hover label ----
    const toolsBtn = stage.querySelector<HTMLElement>("[data-tools-toggle]");
    const toolsRegion = stage.querySelector<HTMLElement>("[data-tools-region]");
    if (toolsBtn && toolsRegion) {
      toolsRegion.dataset.collapsed = "true";
      toolsBtn.addEventListener("click", () => {
        const open = toolsRegion.dataset.collapsed === "true";
        toolsRegion.dataset.collapsed = open ? "false" : "true";
        toolsBtn.setAttribute("aria-expanded", String(open));
      });
    }
    const toolsNow = stage.querySelector<HTMLElement>("[data-tools-now]");
    const toolMarquee = stage.querySelector<HTMLElement>("[data-tool-marquee]");
    if (toolsNow && toolMarquee) {
      const idle = "";
      toolMarquee.querySelectorAll<HTMLElement>("[data-tool-label]").forEach((ch) =>
        ch.addEventListener("mouseenter", () => (toolsNow.textContent = ch.dataset.toolLabel ?? idle))
      );
      toolMarquee.addEventListener("mouseleave", () => (toolsNow.textContent = idle));
    }

    // ---- game lifecycle ----
    // Content reveals as the bugs walk out; the "squash more" button only after
    // they've all left the screen (game:closed).
    document.addEventListener("game:cleared", () => html.classList.add("stage-revealed"));
    document.addEventListener("game:closed", () => html.classList.add("game-done"));
    document.addEventListener("game:open", () => html.classList.remove("game-done"));
    stage.querySelector<HTMLElement>("[data-squash-more]")?.addEventListener("click", () => {
      closePanel();
      document.dispatchEvent(new CustomEvent("game:open", { detail: { killNow: true } }));
    });

    void armed;
  }
</script>
