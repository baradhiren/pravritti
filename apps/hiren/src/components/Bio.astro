---
import { bio, tools } from "../data/content";
---

<section class="bio" id="about" aria-label="About">
  <div class="shell bio__inner">
    <div class="bio__body">
      {
        bio.map((para, i) => (
          <p class={`bio__para reveal ${i === 0 ? "bio__para--lead" : ""}`}>{para}</p>
        ))
      }

      <div class="bio__tools reveal" aria-label="Tools and technologies">
        <span class="bio__tools-label t-mono-label">Toolbox</span>
        <ul class="bio__chips">
          {tools.map((t) => <li class="chip">{t}</li>)}
        </ul>
      </div>
    </div>
  </div>
</section>

<style>
  .bio {
    padding-block: clamp(3.5rem, 8vw, 6.5rem);
  }
  .bio__inner {
    display: grid;
    gap: clamp(1.75rem, 4vw, 3.5rem);
    grid-template-columns: 1fr;
    align-items: start;
  }
  .bio__heading {
    color: var(--ink);
  }
  .bio__em {
    color: var(--coral-ink);
  }
  .bio__body {
    max-width: 60ch;
  }
  .bio__para {
    margin: 0 0 1.15rem;
    color: oklch(0.33 0.018 60);
  }
  .bio__para--lead {
    font-size: 1.18rem;
    line-height: 1.6;
    color: var(--ink);
  }
  .bio__para:last-of-type {
    margin-bottom: 0;
    font-style: italic;
    color: var(--muted);
  }

  .bio__tools {
    margin-top: 2.25rem;
    padding-top: 1.75rem;
    border-top: 1px solid var(--line);
  }
  .bio__tools-label {
    display: block;
    color: var(--muted);
    margin-bottom: 0.9rem;
  }
  .bio__chips {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  .chip {
    font-family: var(--font-mono);
    font-size: 0.82rem;
    padding: 0.34rem 0.7rem;
    border-radius: var(--radius-sm);
    background: var(--surface);
    border: 1px solid var(--line);
    color: oklch(0.3 0.02 60);
    transition:
      background var(--dur-fast) var(--ease-out-quint),
      border-color var(--dur-fast) var(--ease-out-quint),
      transform var(--dur-fast) var(--ease-out-quint);
  }
  .chip:hover {
    background: var(--wash-sun);
    border-color: var(--sun);
    transform: translateY(-2px);
  }

  @media (min-width: 880px) {
    .bio__inner {
      grid-template-columns: 0.85fr 1.15fr;
      gap: clamp(2.5rem, 6vw, 5rem);
    }
    .bio__heading {
      position: sticky;
      top: 6rem;
    }
  }
</style>
