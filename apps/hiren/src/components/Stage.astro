    color: var(--ink);
  }
  .ditem__stat {
    display: inline-flex;
    align-items: baseline;
    gap: 0.6rem;
    margin: 1.2rem 0 0;
    padding: 0.5rem 1rem;
    background: var(--bg);
    border: 1px solid var(--line);
    border-radius: var(--radius);
  }
  .ditem__stat-v {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 1.5rem;
    color: var(--coral-ink);
    line-height: 1;
  }
  .ditem__stat-l {
    font-size: 0.9rem;
    color: var(--muted);
  }
  .ditem__points {
    list-style: none;
    margin: 1.3rem 0 0;
    padding: 0;
    display: grid;
    gap: 0.65rem;
    max-width: 64ch;
